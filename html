<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#111827"><link rel="manifest" href="manifest.json">
<title>Transportes Lucas</title>

<!-- Bibliotecas para gerar PDF -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f3f4f6;color:#111827}
header{background:#111827;color:white;padding:22px 18px;position:sticky;top:0;z-index:2; display:flex; justify-content:space-between; align-items:center;}
h1{font-size:21px;margin:0}header p{margin:5px 0 0;color:#d1d5db;font-size:13px}
main{max-width:900px;margin:auto;padding:14px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.card{background:white;border-radius:14px;padding:16px;box-shadow:0 2px 8px #00000010}.metric{font-size:24px;font-weight:700;margin-top:7px}
button{border:0;border-radius:12px;padding:13px 14px;font-weight:700;cursor:pointer}
.primary{background:#111827;color:white}.secondary{background:#e5e7eb;color:#111827}
.actions{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:14px 0}
label{display:block;font-size:13px;font-weight:700;margin:10px 0 5px}input,select{width:100%;padding:12px;border:1px solid #d1d5db;border-radius:10px;font-size:16px}
.hidden{display:none !important}.row{display:flex;gap:8px;align-items:center;justify-content:space-between}
.list{margin-top:10px}.item{padding:12px 0;border-bottom:1px solid #e5e7eb}
.small{font-size:12px;color:#6b7280}
.card-green { background: #d1fae5; border: 1px solid #10b981; }
.card-red { background: #fee2e2; border: 1px solid #ef4444; }
.card-blue { background: #eff6ff; border: 1px solid #3b82f6; }
@media(min-width:700px){.grid{grid-template-columns:repeat(4,1fr)}.actions{grid-template-columns:repeat(4,1fr)}}
</style>
</head>
<body>

<header>
  <div>
    <h1>TRANSPORTES LUCAS</h1>
    <p>Controle de Frota</p>
  </div>
  <button id="btnSair" class="secondary hidden" style="padding: 8px 12px; font-size: 12px;" onclick="sair()">Sair</button>
</header>

<main>
  <!-- TELA DE LOGIN -->
  <section id="loginScreen" class="card">
    <h2 style="margin-top: 0;">Login no Sistema</h2>
    <label>E-mail</label>
    <input type="email" id="emailInput" placeholder="usuario@empresa.com" required>
    <label>Senha</label>
    <input type="password" id="senhaInput" placeholder="Sua senha" required>
    <br><br>
    <button class="primary" style="width:100%" onclick="entrar()">Entrar</button>
    <p id="loginErro" style="color:red; font-size:13px; display:none; margin-top: 10px; text-align: center; font-weight: bold;"></p>
  </section>

  <!-- DASHBOARD PRINCIPAL -->
  <section id="dashboard" class="hidden">
    <div class="grid">
      <div class="card card-green">Faturamento<div class="metric" id="mFaturamento" style="color:#047857">R$ 0,00</div></div>
      <div class="card card-red">Custos (Desp+Comb+Sal)<div class="metric" id="mCustos" style="color:#b91c1c">R$ 0,00</div></div>
      <div class="card card-blue">Lucro Líquido<div class="metric" id="mLucro" style="color:#1d4ed8">R$ 0,00</div></div>
      <div class="card">Viagens Realizadas<div class="metric" id="mViagens">0</div></div>
    </div>
    
    <div class="actions">
      <button class="primary" onclick="show('frete')">🚚 Lançar frete</button>
      <button class="primary" onclick="show('comb')">⛽ Combustível</button>
      <button class="primary" onclick="show('desp')">💰 Despesa</button>
      <button class="primary" onclick="show('sal')">👷 Salário</button>
    </div>
    
    <div class="card">
      <div class="row" style="margin-bottom: 10px;">
        <b>Últimos lançamentos</b>
        <div style="display:flex; gap:8px;">
          <button class="primary" style="padding: 8px 12px; font-size: 12px; background: #1d4ed8;" onclick="gerarPDF()">📄 Baixar PDF</button>
          <button class="secondary" style="padding: 8px 12px; font-size: 12px;" onclick="clearData()">Limpar</button>
        </div>
      </div>
      <div id="list" class="list"></div>
    </div>
  </section>

  <!-- FORMULÁRIO DE CADASTRO -->
  <section id="form" class="card hidden">
    <div class="row"><h2 id="formTitle"></h2><button class="secondary" onclick="show('dashboard')">Voltar</button></div>
    <form id="entryForm" onsubmit="save(event)">
      <input type="hidden" id="type">
      <label>Data</label><input type="date" id="date" required>
      <label>Caminhão / Placa</label><input id="machine" placeholder="Ex.: Volvo FH 540 / ABC-1234" required>
      <div id="fields"></div>
      <br><button class="primary" style="width:100%">Salvar lançamento</button>
    </form>
  </section>
</main>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
  import { getFirestore, collection, addDoc, onSnapshot, query, orderBy, limit, deleteDoc, getDocs } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";
  import { getAuth, signInWithEmailAndPassword, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-auth.js";

  // ATENÇÃO: COLE AQUI AS CHAVES DO NOVO PROJETO DO FIREBASE (LUCAS)
  const firebaseConfig = {
  apiKey: "AIzaSyAqwHrRFISYOh3p4u9nfdf5pL8cpSBX9iw",
  authDomain: "controlelucas-ac42a.firebaseapp.com",
  projectId: "controlelucas-ac42a",
  storageBucket: "controlelucas-ac42a.firebasestorage.app",
  messagingSenderId: "253759447090",
  appId: "1:253759447090:web:1359418133c7e16c629c2b",
  measurementId: "G-08SPH1LLSG"
};

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);
  const auth = getAuth(app); 
  
  // Banco de dados exclusivo do Lucas
  const lancamentosRef = collection(db, "fretes");

  let data = [];
  let unsubscribeSnapshot = null; 
  const money = v => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(v || 0);
  const moneyPDF = v => 'R$ ' + (v || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  window.entrar = async function() {
    const email = document.getElementById('emailInput').value;
    const senha = document.getElementById('senhaInput').value;
    const erroMsg = document.getElementById('loginErro');
    const btnLogin = document.querySelector('#loginScreen button');
    
    btnLogin.textContent = "Autenticando...";
    btnLogin.disabled = true;
    
    try {
      await signInWithEmailAndPassword(auth, email, senha);
      erroMsg.style.display = 'none';
      btnLogin.textContent = "Entrar";
      btnLogin.disabled = false;
    } catch(error) {
      erroMsg.textContent = "Erro: E-mail ou senha incorretos.";
      erroMsg.style.display = 'block';
      btnLogin.textContent = "Entrar";
      btnLogin.disabled = false;
    }
  }

  window.sair = function() { signOut(auth); }

  onAuthStateChanged(auth, (user) => {
    if (user) {
      document.getElementById('loginScreen').classList.add('hidden');
      document.getElementById('dashboard').classList.remove('hidden');
      document.getElementById('btnSair').classList.remove('hidden');
      
      const queryOrdenada = query(lancamentosRef, orderBy("timestamp", "desc"), limit(200)); 
      unsubscribeSnapshot = onSnapshot(queryOrdenada, (snapshot) => {
        data = [];
        snapshot.forEach((doc) => data.push(doc.data()));
        render(); 
      });
    } else {
      document.getElementById('loginScreen').classList.remove('hidden');
      document.getElementById('dashboard').classList.add('hidden');
      document.getElementById('form').classList.add('hidden');
      document.getElementById('btnSair').classList.add('hidden');
      if(unsubscribeSnapshot) { unsubscribeSnapshot(); unsubscribeSnapshot = null; }
    }
  });

  window.show = function(type) {
    document.getElementById('dashboard').classList.toggle('hidden', type !== 'dashboard');
    document.getElementById('form').classList.toggle('hidden', type === 'dashboard');
    if(type === 'dashboard') { render(); return; }
    
    const titles = { frete: 'Registrar Frete', comb: 'Registrar combustível', desp: 'Registrar despesa', sal: 'Registrar salário' };
    document.getElementById('formTitle').textContent = titles[type];
    document.getElementById('type').value = type;
    document.getElementById('date').value = new Date().toISOString().slice(0, 10);
    
    const f = document.getElementById('fields');
    
    const map = {
      frete: `
        <label>Cliente / Carga</label><input id="desc" placeholder="Ex: Soja - Transportadora XYZ" required>
        <div class="row">
          <div style="width:50%"><label>Origem</label><input id="origem" placeholder="Ex: Cascavel, PR" required></div>
          <div style="width:50%"><label>Destino</label><input id="destino" placeholder="Ex: Paranaguá, PR" required></div>
        </div>
        <label>Valor do Frete (R$)</label><input type="number" step="0.01" id="valorFrete" required>
      `,
      comb: '<label>Litros abastecidos</label><input type="number" step="0.01" id="value" required><label>Valor total (R$)</label><input type="number" step="0.01" id="value2" required>',
      desp: '<label>Descrição</label><input id="desc" placeholder="Peça, manutenção, pneu, pedágio..." required><label>Valor (R$)</label><input type="number" step="0.01" id="value" required>',
      sal: '<label>Motorista</label><input id="operator" required><label>Valor pago (R$)</label><input type="number" step="0.01" id="value" required>'
    };
    f.innerHTML = map[type];
  }

  window.save = async function(e) {
    e.preventDefault(); 
    const btn = e.target.querySelector('button');
    const type = document.getElementById('type').value;
    
    let finalValue = 0;
    let finalValue2 = 0;
    let descOrigem = '';
    let descDestino = '';

    if (type === 'frete') {
      finalValue = 1; 
      finalValue2 = +(document.getElementById('valorFrete').value || 0);
      descOrigem = document.getElementById('origem').value;
      descDestino = document.getElementById('destino').value;
    } else {
      finalValue = +(document.getElementById('value')?.value || 0);
      finalValue2 = +(document.getElementById('value2')?.value || 0);
    }

    btn.textContent = 'Salvando...';
    btn.disabled = true;

    const o = {
      type, 
      date: document.getElementById('date').value, 
      machine: document.getElementById('machine').value, 
      value: finalValue,
      value2: finalValue2, 
      desc: document.getElementById('desc')?.value || '',
      origem: descOrigem,
      destino: descDestino,
      operator: document.getElementById('operator')?.value || '',
      timestamp: new Date().getTime()
    };

    try {
      await addDoc(lancamentosRef, o);
      window.show('dashboard');
    } catch(error) {
      alert("Erro ao salvar: Você tem permissão?");
    } finally {
      btn.textContent = 'Salvar lançamento';
      btn.disabled = false;
    }
  }

  window.clearData = async function() {
    if(confirm('Apagar todos os lançamentos do servidor? ISSO NÃO PODE SER DESFEITO.')) {
      try {
        const snapshot = await getDocs(lancamentosRef);
        snapshot.forEach((doc) => deleteDoc(doc.ref));
      } catch(error) {
        alert("Erro: Apenas usuários autorizados podem apagar dados.");
      }
    }
  }

  window.gerarPDF = function() {
    if (data.length === 0) {
      alert("Não há dados para gerar o relatório.");
      return;
    }

    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();
    const dataAtual = new Date().toLocaleDateString('pt-BR');

    doc.setFontSize(16);
    doc.text("Relatorio Gerencial - Transportes Lucas", 14, 20);
    doc.setFontSize(10);
    doc.text(`Gerado em: ${dataAtual}`, 14, 26);

    let fat = 0, cust = 0, viagensT = 0;
    data.forEach(x => {
      if(x.type === 'frete') { fat += x.value2; viagensT += x.value; }
      if(x.type === 'comb') cust += x.value2;
      if(x.type === 'desp') cust += x.value;
      if(x.type === 'sal') cust += x.value;
    });
    const lucro = fat - cust;

    doc.setFontSize(11);
    doc.text(`Faturamento Total: ${moneyPDF(fat)}`, 14, 38);
    doc.text(`Custos Totais: ${moneyPDF(cust)}`, 14, 44);
    doc.text(`Lucro Liquido: ${moneyPDF(lucro)}`, 14, 50);
    doc.text(`Viagens Realizadas: ${viagensT}`, 14, 56);

    doc.line(14, 60, 195, 60);

    const linhas = data.map(x => {
      let tipo = '', valorTexto = '', detalhe = '';
      if(x.type === 'frete') { 
        tipo = 'Frete'; 
        valorTexto = moneyPDF(x.value2); 
        detalhe = `${x.origem} -> ${x.destino} (${x.desc})`; 
      }
      if(x.type === 'comb') { tipo = 'Combustível'; valorTexto = moneyPDF(x.value2); detalhe = x.desc || '-'; }
      if(x.type === 'desp') { tipo = 'Despesa'; valorTexto = moneyPDF(x.value); detalhe = x.desc || '-'; }
      if(x.type === 'sal') { tipo = 'Pagamento'; valorTexto = moneyPDF(x.value); detalhe = x.operator || '-'; }

      const dataFormatada = x.date.split('-').reverse().join('/');
      return [dataFormatada, tipo, x.machine, detalhe, valorTexto];
    });

    doc.autoTable({
      startY: 65,
      head: [['Data', 'Tipo', 'Caminhão', 'Detalhes / Rota', 'Valor']],
      body: linhas,
      theme: 'grid',
      headStyles: { fillColor: [17, 24, 39] },
      styles: { fontSize: 9 }
    });

    doc.save(`Relatorio_Frota_Lucas_${dataAtual.replace(/\//g, '-')}.pdf`);
  }

  function render() {
    let faturamento = 0, custos = 0, viagensTotal = 0;
    
    data.forEach(x => {
      if(x.type === 'frete') {
        viagensTotal += x.value; 
        faturamento += x.value2; 
      }
      if(x.type === 'comb') custos += x.value2; 
      if(x.type === 'desp') custos += x.value;  
      if(x.type === 'sal') custos += x.value;   
    });
    
    const lucro = faturamento - custos;

    document.getElementById('mFaturamento').textContent = money(faturamento);
    document.getElementById('mCustos').textContent = money(custos);
    document.getElementById('mLucro').textContent = money(lucro);
    document.getElementById('mViagens').textContent = viagensTotal;
    
    document.getElementById('mLucro').style.color = lucro >= 0 ? '#1d4ed8' : '#b91c1c';
    
    document.getElementById('list').innerHTML = data.map(x => {
      const names = { frete: '🚚 Frete', comb: '⛽ Combustível', desp: '💰 Despesa', sal: '👷 Salário' };
      
      let valText = '';
      if(x.type === 'frete') valText = `<b>${money(x.value2)}</b>`;
      else if(x.type === 'comb') valText = `${x.value} L — <b>${money(x.value2)}</b>`;
      else valText = `<b>${money(x.value)}</b>`;

      const itemDesc = x.type === 'frete' ? `${x.origem} ➔ ${x.destino} <br><span class="small">${x.desc}</span>` : `<span class="small">${x.operator || x.desc || ''}</span>`;

      return `<div class="item"><b>${names[x.type]}</b> — ${x.machine}<br><span class="small">${x.date}</span> · ${itemDesc}<br>${valText}</div>`;
    }).join('') || '<div class="small">Nenhum lançamento ainda.</div>';
  }
</script>

</body>
</html>